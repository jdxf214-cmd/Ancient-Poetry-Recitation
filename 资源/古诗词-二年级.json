{
  "version": "1.1",
  "scope": "统编版（人教部编版）小学语文",
  "grade": 2,
  "count": 14,
  "poems": [
    {
      "id": 14,
      "title": "梅花",
      "dynasty": "宋",
      "author": "王安石",
      "grade": 2,
      "semester": "上",
      "genre": "五言绝句",
      "tags": ["咏物", "品格"],
      "lines": ["墙角数枝梅，", "凌寒独自开。", "遥知不是雪，", "为有暗香来。"],
      "notes": [
        { "w": "凌寒", "t": "冒着严寒。" },
        { "w": "遥知", "t": "远远地知道。" },
        { "w": "为", "t": "因为。" },
        { "w": "暗香", "t": "淡淡的香气。" }
      ],
      "translation": ["墙角有几枝梅花，冒着严寒独自开放。", "远远就知道那不是雪，因为有淡淡的清香飘过来。"]
    },
    {
      "id": 15,
      "title": "小儿垂钓",
      "dynasty": "唐",
      "author": "胡令能",
      "grade": 2,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["童趣", "叙事"],
      "lines": ["蓬头稚子学垂纶，", "侧坐莓苔草映身。", "路人借问遥招手，", "怕得鱼惊不应人。"],
      "notes": [
        { "w": "蓬头", "t": "头发乱蓬蓬的。" },
        { "w": "稚子", "t": "小孩子。" },
        { "w": "垂纶", "t": "钓鱼。纶，钓鱼用的线。" },
        { "w": "莓苔", "t": "青苔。" },
        { "w": "借问", "t": "向人打听。" },
        { "w": "应", "t": "回答。" }
      ],
      "translation": ["一个头发乱蓬蓬的小孩在学钓鱼，侧身坐在青苔上，野草遮住了他的身子。", "过路人向他问路，他远远地摆手，怕惊动了鱼，不敢回答。"]
    },
    {
      "id": 16,
      "title": "登鹳雀楼",
      "dynasty": "唐",
      "author": "王之涣",
      "grade": 2,
      "semester": "上",
      "genre": "五言绝句",
      "tags": ["写景", "哲理"],
      "lines": ["白日依山尽，", "黄河入海流。", "欲穷千里目，", "更上一层楼。"],
      "notes": [
        { "w": "白日", "t": "太阳。" },
        { "w": "依", "t": "依傍、靠着。" },
        { "w": "尽", "t": "消失。" },
        { "w": "欲", "t": "想要。" },
        { "w": "穷", "t": "尽，这里是看到尽头的意思。" },
        { "w": "更", "t": "再。" }
      ],
      "translation": ["太阳依傍着群山慢慢落下，黄河奔腾着流向大海。", "想要看到千里之外的景色，就要再登上一层楼。"]
    },
    {
      "id": 17,
      "title": "望庐山瀑布",
      "dynasty": "唐",
      "author": "李白",
      "grade": 2,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["写景", "山水"],
      "lines": ["日照香炉生紫烟，", "遥看瀑布挂前川。", "飞流直下三千尺，", "疑是银河落九天。"],
      "notes": [
        { "w": "香炉", "t": "指庐山的香炉峰。" },
        { "w": "紫烟", "t": "紫色的云雾。" },
        { "w": "遥看", "t": "远远地看。" },
        { "w": "川", "t": "河流。" },
        { "w": "三千尺", "t": "形容极高，不是确数。" },
        { "w": "九天", "t": "天空的最高处。" }
      ],
      "translation": ["阳光照着香炉峰，升起紫色的云烟，远远望去，瀑布像一条白练挂在山前的河面上。", "水流飞泻直下三千尺，让人怀疑是银河从九天之上落了下来。"]
    },
    {
      "id": 18,
      "title": "江雪",
      "dynasty": "唐",
      "author": "柳宗元",
      "grade": 2,
      "semester": "上",
      "genre": "五言绝句",
      "tags": ["写景", "冬天"],
      "lines": ["千山鸟飞绝，", "万径人踪灭。", "孤舟蓑笠翁，", "独钓寒江雪。"],
      "notes": [
        { "w": "绝", "t": "尽，这里指消失。" },
        { "w": "径", "t": "小路。" },
        { "w": "踪", "t": "踪迹。" },
        { "w": "蓑笠翁", "t": "披着蓑衣、戴着斗笠的老人。" }
      ],
      "translation": ["群山中鸟儿都飞走了，所有小路上也看不见人的踪迹。", "只有一叶孤舟上，一位披着蓑衣、戴着斗笠的老翁，独自在风雪寒江中垂钓。"]
    },
    {
      "id": 19,
      "title": "夜宿山寺",
      "dynasty": "唐",
      "author": "李白",
      "grade": 2,
      "semester": "上",
      "genre": "五言绝句",
      "tags": ["写景", "想象"],
      "lines": ["危楼高百尺，", "手可摘星辰。", "不敢高声语，", "恐惊天上人。"],
      "notes": [
        { "w": "危楼", "t": "高楼。" },
        { "w": "百尺", "t": "形容很高，不是确数。" },
        { "w": "星辰", "t": "星星。" },
        { "w": "语", "t": "说话。" },
        { "w": "恐", "t": "怕。" }
      ],
      "translation": ["山寺的高楼足有百尺高，伸手仿佛就能摘到天上的星辰。", "不敢大声说话，怕惊动了天上的仙人。"]
    },
    {
      "id": 20,
      "title": "敕勒歌",
      "dynasty": "南北朝",
      "author": "北朝民歌",
      "grade": 2,
      "semester": "上",
      "genre": "乐府诗",
      "tags": ["写景", "草原"],
      "lines": ["敕勒川，", "阴山下。", "天似穹庐，", "笼盖四野。", "天苍苍，", "野茫茫，", "风吹草低见牛羊。"],
      "notes": [
        { "w": "敕勒川", "t": "敕勒族居住的平原。" },
        { "w": "阴山", "t": "山名，在今内蒙古中部。" },
        { "w": "穹庐", "t": "圆顶的毡帐。" },
        { "w": "笼盖", "t": "笼罩。" },
        { "w": "苍苍", "t": "深青色。" },
        { "w": "茫茫", "t": "辽阔无边。" },
        { "w": "见", "t": "同“现”，显现。" }
      ],
      "translation": ["敕勒族居住的平原，就在阴山脚下。", "天空像巨大的圆顶毡帐，笼罩着四面的原野。", "天色苍苍，原野茫茫，风吹草低，显露出成群的牛羊。"]
    },
    {
      "id": 21,
      "title": "村居",
      "dynasty": "清",
      "author": "高鼎",
      "grade": 2,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["写景", "春天", "童趣"],
      "lines": ["草长莺飞二月天，", "拂堤杨柳醉春烟。", "儿童散学归来早，", "忙趁东风放纸鸢。"],
      "notes": [
        { "w": "拂堤", "t": "轻拂堤岸。" },
        { "w": "醉", "t": "陶醉。" },
        { "w": "春烟", "t": "春天水泽、草木间蒸腾的雾气。" },
        { "w": "散学", "t": "放学。" },
        { "w": "纸鸢", "t": "风筝。" }
      ],
      "translation": ["二月里青草生长、黄莺飞舞，杨柳轻拂着堤岸，陶醉在春天的烟雾里。", "孩子们放学回来得早，急忙趁着东风放起了风筝。"]
    },
    {
      "id": 22,
      "title": "咏柳",
      "dynasty": "唐",
      "author": "贺知章",
      "grade": 2,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["咏物", "春天"],
      "lines": ["碧玉妆成一树高，", "万条垂下绿丝绦。", "不知细叶谁裁出，", "二月春风似剪刀。"],
      "notes": [
        { "w": "碧玉", "t": "碧绿色的玉，这里比喻柳树的嫩叶。" },
        { "w": "妆", "t": "打扮。" },
        { "w": "丝绦", "t": "丝带，这里比喻柳条。" },
        { "w": "裁", "t": "裁剪。" },
        { "w": "似", "t": "像。" }
      ],
      "translation": ["高高的柳树像用碧玉装扮而成，万千柳条垂下来，像绿色的丝带。", "不知道这细细的柳叶是谁裁出来的，原来二月的春风就像剪刀。"]
    },
    {
      "id": 23,
      "title": "赋得古原草送别（节选）",
      "dynasty": "唐",
      "author": "白居易",
      "grade": 2,
      "semester": "下",
      "genre": "五言律诗",
      "tags": ["咏物", "送别"],
      "lines": ["离离原上草，", "一岁一枯荣。", "野火烧不尽，", "春风吹又生。"],
      "notes": [
        { "w": "离离", "t": "草木茂盛的样子。" },
        { "w": "岁", "t": "年。" },
        { "w": "枯荣", "t": "枯萎和茂盛。" },
        { "w": "尽", "t": "完。" }
      ],
      "translation": ["原野上的草长得十分茂盛，一年之中枯萎一次，茂盛一次。", "野火也烧不完它，春风一吹，它又生长出来。"]
    },
    {
      "id": 24,
      "title": "晓出净慈寺送林子方",
      "dynasty": "宋",
      "author": "杨万里",
      "grade": 2,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["送别", "夏天"],
      "lines": ["毕竟西湖六月中，", "风光不与四时同。", "接天莲叶无穷碧，", "映日荷花别样红。"],
      "notes": [
        { "w": "晓", "t": "早晨。" },
        { "w": "净慈寺", "t": "杭州西湖边的寺庙。" },
        { "w": "毕竟", "t": "终究、到底。" },
        { "w": "四时", "t": "四季。" },
        { "w": "接天", "t": "与天相接。" },
        { "w": "别样", "t": "特别、不一样。" }
      ],
      "translation": ["到底是六月的西湖，风光和其他季节都不相同。", "碧绿的莲叶铺到天边，无穷无尽；荷花映着朝阳，显得格外红艳。"]
    },
    {
      "id": 25,
      "title": "绝句（两个黄鹂鸣翠柳）",
      "dynasty": "唐",
      "author": "杜甫",
      "grade": 2,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["写景", "春天"],
      "lines": ["两个黄鹂鸣翠柳，", "一行白鹭上青天。", "窗含西岭千秋雪，", "门泊东吴万里船。"],
      "notes": [
        { "w": "含", "t": "包含，这里指从窗口望去，像嵌在窗框里。" },
        { "w": "千秋雪", "t": "终年不化的积雪。" },
        { "w": "泊", "t": "停泊。" },
        { "w": "东吴", "t": "今江苏一带。" }
      ],
      "translation": ["两只黄鹂在翠绿的柳枝上鸣叫，一行白鹭飞向蓝天。", "窗口正对着西岭上千年不化的积雪，门前停泊着来自东吴的万里行船。"]
    },
    {
      "id": 26,
      "title": "悯农（其一）",
      "dynasty": "唐",
      "author": "李绅",
      "grade": 2,
      "semester": "下",
      "genre": "五言绝句",
      "tags": ["劳动", "讽喻"],
      "lines": ["春种一粒粟，", "秋收万颗子。", "四海无闲田，", "农夫犹饿死。"],
      "notes": [
        { "w": "粟", "t": "谷子，泛指粮食。" },
        { "w": "子", "t": "这里指粮食。" },
        { "w": "四海", "t": "全国。" },
        { "w": "闲田", "t": "空闲的田地。" },
        { "w": "犹", "t": "还、仍然。" }
      ],
      "translation": ["春天种下一粒谷种，秋天能收获万颗粮食。", "天下没有一块空闲的田地，农民却仍然会饿死。"]
    },
    {
      "id": 27,
      "title": "舟夜书所见",
      "dynasty": "清",
      "author": "查慎行",
      "grade": 2,
      "semester": "下",
      "genre": "五言绝句",
      "tags": ["写景", "夜晚"],
      "lines": ["月黑见渔灯，", "孤光一点萤。", "微微风簇浪，", "散作满河星。"],
      "notes": [
        { "w": "书", "t": "写、记录。" },
        { "w": "渔灯", "t": "渔船上的灯。" },
        { "w": "孤光", "t": "孤单的灯光。" },
        { "w": "簇", "t": "聚集、激起。" }
      ],
      "translation": ["没有月光的夜里，看见一盏渔灯，孤单的光亮像一点萤火。", "微风吹起层层细浪，灯光散开，化作满河的星星。"]
    }
  ]
}
