{
  "version": "1.1",
  "scope": "统编版（人教部编版）小学语文",
  "grade": 5,
  "count": 22,
  "poems": [
    {
      "id": 65,
      "title": "蝉",
      "dynasty": "唐",
      "author": "虞世南",
      "grade": 5,
      "semester": "上",
      "genre": "五言绝句",
      "tags": ["咏物", "品格"],
      "lines": ["垂緌饮清露，", "流响出疏桐。", "居高声自远，", "非是藉秋风。"],
      "notes": [
        { "w": "垂緌", "t": "帽带下垂的部分，这里指蝉的触须。" },
        { "w": "清露", "t": "清清的露水。" },
        { "w": "流响", "t": "连续不断的鸣叫声。" },
        { "w": "疏桐", "t": "稀疏的梧桐树。" },
        { "w": "藉", "t": "凭借、依靠。" }
      ],
      "translation": ["蝉垂下触须，饮用清清的露水，鸣叫声从稀疏的梧桐叶间传出。", "它身居高处，声音自然传得远，并不是凭借秋风。"]
    },
    {
      "id": 66,
      "title": "乞巧",
      "dynasty": "唐",
      "author": "林杰",
      "grade": 5,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["节日", "民俗"],
      "lines": ["七夕今宵看碧霄，", "牵牛织女渡河桥。", "家家乞巧望秋月，", "穿尽红丝几万条。"],
      "notes": [
        { "w": "乞巧", "t": "向织女乞求一双巧手。" },
        { "w": "碧霄", "t": "青天。" },
        { "w": "河桥", "t": "鹊桥。" },
        { "w": "红丝", "t": "红色的丝线，乞巧时穿针用。" }
      ],
      "translation": ["七夕的夜晚，仰望青天，牵牛星和织女星在鹊桥上相会。", "家家户户望着秋月乞求巧手，穿过的红丝线有几万条。"]
    },
    {
      "id": 67,
      "title": "示儿",
      "dynasty": "宋",
      "author": "陆游",
      "grade": 5,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["爱国", "绝笔"],
      "lines": ["死去元知万事空，", "但悲不见九州同。", "王师北定中原日，", "家祭无忘告乃翁。"],
      "notes": [
        { "w": "示儿", "t": "写给儿子们看。" },
        { "w": "元知", "t": "本来就知道。" },
        { "w": "但", "t": "只。" },
        { "w": "九州同", "t": "国家统一。" },
        { "w": "王师", "t": "朝廷的军队。" },
        { "w": "乃翁", "t": "你们的父亲。" }
      ],
      "translation": ["我本来就知道，死后万事皆空，只悲伤没能看到国家统一。", "等到朝廷军队收复中原的那一天，家祭时别忘了告诉你们的父亲。"]
    },
    {
      "id": 68,
      "title": "题临安邸",
      "dynasty": "宋",
      "author": "林升",
      "grade": 5,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["讽喻", "爱国"],
      "lines": ["山外青山楼外楼，", "西湖歌舞几时休？", "暖风熏得游人醉，", "直把杭州作汴州。"],
      "notes": [
        { "w": "临安", "t": "南宋都城，今浙江杭州。" },
        { "w": "邸", "t": "旅店。" },
        { "w": "几时休", "t": "什么时候停止。" },
        { "w": "熏", "t": "吹拂、熏陶。" },
        { "w": "直", "t": "简直。" },
        { "w": "汴州", "t": "北宋都城，今河南开封。" }
      ],
      "translation": ["山外还有青山，楼外还有高楼，西湖边的歌舞什么时候才能停止？", "暖风把游人吹得沉醉，简直把杭州当成了故都汴州。"]
    },
    {
      "id": 69,
      "title": "己亥杂诗",
      "dynasty": "清",
      "author": "龚自珍",
      "grade": 5,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["爱国", "改革"],
      "lines": ["九州生气恃风雷，", "万马齐喑究可哀。", "我劝天公重抖擞，", "不拘一格降人才。"],
      "notes": [
        { "w": "生气", "t": "活力、生机。" },
        { "w": "恃", "t": "依靠。" },
        { "w": "喑", "t": "沉默不语。" },
        { "w": "究", "t": "终究。" },
        { "w": "抖擞", "t": "振作精神。" },
        { "w": "不拘一格", "t": "不局限于一种规格。" }
      ],
      "translation": ["国家的生机要靠风雷般的变革，万马齐喑的局面实在可悲。", "我劝上天重新振作精神，不要拘守一种规格，降下更多的人才。"]
    },
    {
      "id": 70,
      "title": "山居秋暝",
      "dynasty": "唐",
      "author": "王维",
      "grade": 5,
      "semester": "上",
      "genre": "五言律诗",
      "tags": ["山水", "田园"],
      "lines": ["空山新雨后，", "天气晚来秋。", "明月松间照，", "清泉石上流。", "竹喧归浣女，", "莲动下渔舟。", "随意春芳歇，", "王孙自可留。"],
      "notes": [
        { "w": "暝", "t": "傍晚。" },
        { "w": "新雨", "t": "刚下过的雨。" },
        { "w": "浣女", "t": "洗衣服的女子。" },
        { "w": "春芳歇", "t": "春天的花草凋谢。" },
        { "w": "王孙", "t": "原指贵族子弟，这里指诗人自己。" }
      ],
      "translation": ["空旷的山中刚下过一场新雨，傍晚的天气更显出秋意。", "明月从松林间洒下清辉，清泉在石头上潺潺流淌。", "竹林喧响，是洗衣的女子归来；莲叶摇动，是渔舟顺流而下。", "任凭春天的花草凋谢，我自然可以留在这山中。"]
    },
    {
      "id": 71,
      "title": "枫桥夜泊",
      "dynasty": "唐",
      "author": "张继",
      "grade": 5,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["行旅", "秋天"],
      "lines": ["月落乌啼霜满天，", "江枫渔火对愁眠。", "姑苏城外寒山寺，", "夜半钟声到客船。"],
      "notes": [
        { "w": "枫桥", "t": "在今江苏苏州。" },
        { "w": "泊", "t": "停船靠岸。" },
        { "w": "江枫", "t": "江边的枫树。" },
        { "w": "渔火", "t": "渔船上的灯火。" },
        { "w": "姑苏", "t": "苏州的别称。" },
        { "w": "寒山寺", "t": "在苏州西郊。" }
      ],
      "translation": ["月亮落下，乌鸦啼叫，寒霜满天，江边的枫树和渔火相伴着愁苦难眠的我。", "姑苏城外的寒山寺，半夜的钟声传到了客船上。"]
    },
    {
      "id": 72,
      "title": "长相思",
      "dynasty": "清",
      "author": "纳兰性德",
      "grade": 5,
      "semester": "上",
      "genre": "词",
      "tags": ["思乡", "行旅"],
      "lines": ["山一程，", "水一程，", "身向榆关那畔行，", "夜深千帐灯。", "风一更，", "雪一更，", "聒碎乡心梦不成，", "故园无此声。"],
      "notes": [
        { "w": "程", "t": "路程。" },
        { "w": "榆关", "t": "山海关。" },
        { "w": "那畔", "t": "那边。" },
        { "w": "更", "t": "古代夜间计时单位。" },
        { "w": "聒", "t": "声音嘈杂，使人厌烦。" },
        { "w": "故园", "t": "故乡。" }
      ],
      "translation": ["翻过一座座山，涉过一条条水，队伍向山海关那边行进，夜深了，千万座营帐都亮着灯。", "风一更，雪一更，嘈杂的风雪声搅碎了思乡的心，连梦都做不成，故乡可没有这样的声音。"]
    },
    {
      "id": 73,
      "title": "渔歌子",
      "dynasty": "唐",
      "author": "张志和",
      "grade": 5,
      "semester": "上",
      "genre": "词",
      "tags": ["山水", "隐居"],
      "lines": ["西塞山前白鹭飞，", "桃花流水鳜鱼肥。", "青箬笠，", "绿蓑衣，", "斜风细雨不须归。"],
      "notes": [
        { "w": "西塞山", "t": "在今浙江湖州。" },
        { "w": "鳜鱼", "t": "一种味道鲜美的鱼。" },
        { "w": "箬笠", "t": "竹叶编成的斗笠。" },
        { "w": "蓑衣", "t": "草编的雨衣。" },
        { "w": "不须", "t": "不必。" }
      ],
      "translation": ["西塞山前白鹭飞翔，桃花盛开，江水上涨，鳜鱼正肥。", "戴着青箬笠，披着绿蓑衣，斜风细雨中也不必回家。"]
    },
    {
      "id": 74,
      "title": "观书有感（其一）",
      "dynasty": "宋",
      "author": "朱熹",
      "grade": 5,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["哲理", "读书"],
      "lines": ["半亩方塘一鉴开，", "天光云影共徘徊。", "问渠那得清如许？", "为有源头活水来。"],
      "notes": [
        { "w": "方塘", "t": "方形的水塘。" },
        { "w": "鉴", "t": "镜子。" },
        { "w": "徘徊", "t": "来回移动。" },
        { "w": "渠", "t": "它，指方塘。" },
        { "w": "如许", "t": "这样、如此。" }
      ],
      "translation": ["半亩大的方塘像一面镜子一样打开，天光和云影一起在水中徘徊。", "问它为什么能这样清澈？因为源头有活水不断流来。"]
    },
    {
      "id": 75,
      "title": "观书有感（其二）",
      "dynasty": "宋",
      "author": "朱熹",
      "grade": 5,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["哲理", "读书"],
      "lines": ["昨夜江边春水生，", "蒙冲巨舰一毛轻。", "向来枉费推移力，", "此日中流自在行。"],
      "notes": [
        { "w": "蒙冲", "t": "古代的一种战船。" },
        { "w": "一毛", "t": "一根羽毛，形容轻。" },
        { "w": "向来", "t": "从前、以往。" },
        { "w": "枉费", "t": "白白耗费。" },
        { "w": "中流", "t": "江心。" }
      ],
      "translation": ["昨夜江边春水上涨，巨大的战船像一片羽毛那样轻。", "从前白白费了许多推船的力气，今天它却在江心自由自在地航行。"]
    },
    {
      "id": 76,
      "title": "四时田园杂兴（其三十一）",
      "dynasty": "宋",
      "author": "范成大",
      "grade": 5,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["田园", "劳动"],
      "lines": ["昼出耘田夜绩麻，", "村庄儿女各当家。", "童孙未解供耕织，", "也傍桑阴学种瓜。"],
      "notes": [
        { "w": "昼", "t": "白天。" },
        { "w": "耘田", "t": "在田里除草。" },
        { "w": "绩麻", "t": "把麻搓成线。" },
        { "w": "各当家", "t": "各自承担家里的活计。" },
        { "w": "未解", "t": "不懂得。" },
        { "w": "供", "t": "从事。" }
      ],
      "translation": ["白天出去锄草，夜里在家搓麻线，村里的男男女女各自承担着家里的活计。", "小孩子们不懂得耕田织布，也在桑树荫下学着种瓜。"]
    },
    {
      "id": 77,
      "title": "稚子弄冰",
      "dynasty": "宋",
      "author": "杨万里",
      "grade": 5,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["童趣", "冬天"],
      "lines": ["稚子金盆脱晓冰，", "彩丝穿取当银钲。", "敲成玉磬穿林响，", "忽作玻璃碎地声。"],
      "notes": [
        { "w": "稚子", "t": "小孩子。" },
        { "w": "脱晓冰", "t": "把夜里冻成的冰从盆里取出来。" },
        { "w": "钲", "t": "古代的一种铜锣。" },
        { "w": "磬", "t": "古代石制打击乐器。" },
        { "w": "玻璃", "t": "古时指天然玉石。" }
      ],
      "translation": ["小孩子从铜盆里取出夜里冻成的冰，用彩线穿起来，当作银锣来敲。", "敲出的声音像玉磬一样穿过树林，忽然冰块落地，发出玉石碎裂的声音。"]
    },
    {
      "id": 78,
      "title": "村晚",
      "dynasty": "宋",
      "author": "雷震",
      "grade": 5,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["田园", "傍晚"],
      "lines": ["草满池塘水满陂，", "山衔落日浸寒漪。", "牧童归去横牛背，", "短笛无腔信口吹。"],
      "notes": [
        { "w": "陂", "t": "池塘。" },
        { "w": "衔", "t": "含着。" },
        { "w": "漪", "t": "水面的波纹。" },
        { "w": "横", "t": "横坐。" },
        { "w": "腔", "t": "曲调。" }
      ],
      "translation": ["青草长满池塘，池水漫上塘岸，远山衔着落日，倒映在清凉的水波中。", "牧童横坐在牛背上回家，拿着短笛随口吹着不成调的曲子。"]
    },
    {
      "id": 79,
      "title": "游子吟",
      "dynasty": "唐",
      "author": "孟郊",
      "grade": 5,
      "semester": "下",
      "genre": "五言古诗",
      "tags": ["母爱", "亲情"],
      "lines": ["慈母手中线，", "游子身上衣。", "临行密密缝，", "意恐迟迟归。", "谁言寸草心，", "报得三春晖。"],
      "notes": [
        { "w": "游子", "t": "出门在外的人。" },
        { "w": "临行", "t": "将要出发。" },
        { "w": "意恐", "t": "担心。" },
        { "w": "寸草", "t": "小草，比喻子女。" },
        { "w": "三春晖", "t": "春天温暖的阳光，比喻母爱。" }
      ],
      "translation": ["慈母手中的针线，缝出游子身上的衣裳。", "临行前密密地缝着，怕的是孩子迟迟不能归来。", "谁说像小草一样的孝心，能报答得了春天阳光般的母爱呢？"]
    },
    {
      "id": 80,
      "title": "鸟鸣涧",
      "dynasty": "唐",
      "author": "王维",
      "grade": 5,
      "semester": "下",
      "genre": "五言绝句",
      "tags": ["山水", "夜晚"],
      "lines": ["人闲桂花落，", "夜静春山空。", "月出惊山鸟，", "时鸣春涧中。"],
      "notes": [
        { "w": "涧", "t": "山间的小溪。" },
        { "w": "闲", "t": "安静、闲适。" },
        { "w": "空", "t": "空寂。" },
        { "w": "时鸣", "t": "不时地鸣叫。" }
      ],
      "translation": ["人声安静，桂花悄然飘落，夜色静谧，春山显得格外空寂。", "月亮升起，惊动了山鸟，它们不时在春天的山涧中鸣叫。"]
    },
    {
      "id": 81,
      "title": "从军行",
      "dynasty": "唐",
      "author": "王昌龄",
      "grade": 5,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["边塞", "爱国"],
      "lines": ["青海长云暗雪山，", "孤城遥望玉门关。", "黄沙百战穿金甲，", "不破楼兰终不还。"],
      "notes": [
        { "w": "青海", "t": "青海湖。" },
        { "w": "雪山", "t": "指祁连山。" },
        { "w": "玉门关", "t": "在今甘肃敦煌。" },
        { "w": "穿", "t": "磨穿。" },
        { "w": "楼兰", "t": "西域古国，这里代指敌人。" }
      ],
      "translation": ["青海湖上长云弥漫，遮暗了雪山，孤城远远地望着玉门关。", "在黄沙中身经百战，磨穿了铠甲，不打败敌人绝不回还。"]
    },
    {
      "id": 82,
      "title": "秋夜将晓出篱门迎凉有感",
      "dynasty": "宋",
      "author": "陆游",
      "grade": 5,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["爱国", "忧国"],
      "lines": ["三万里河东入海，", "五千仞岳上摩天。", "遗民泪尽胡尘里，", "南望王师又一年。"],
      "notes": [
        { "w": "将晓", "t": "快要天亮。" },
        { "w": "三万里河", "t": "指黄河。" },
        { "w": "五千仞岳", "t": "指华山。" },
        { "w": "摩天", "t": "碰到天。" },
        { "w": "遗民", "t": "沦陷区的百姓。" },
        { "w": "王师", "t": "朝廷的军队。" }
      ],
      "translation": ["三万里长的黄河向东流入大海，五千仞高的华山直插云天。", "沦陷区的百姓在敌人的铁蹄下流尽了眼泪，盼望朝廷军队北伐，又过了一年。"]
    },
    {
      "id": 83,
      "title": "闻官军收河南河北",
      "dynasty": "唐",
      "author": "杜甫",
      "grade": 5,
      "semester": "下",
      "genre": "七言律诗",
      "tags": ["爱国", "喜悦"],
      "lines": ["剑外忽传收蓟北，", "初闻涕泪满衣裳。", "却看妻子愁何在，", "漫卷诗书喜欲狂。", "白日放歌须纵酒，", "青春作伴好还乡。", "即从巴峡穿巫峡，", "便下襄阳向洛阳。"],
      "notes": [
        { "w": "剑外", "t": "剑门关以南，指四川。" },
        { "w": "蓟北", "t": "今河北北部，安史叛军的老巢。" },
