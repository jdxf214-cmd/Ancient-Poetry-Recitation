{
  "version": "1.1",
  "scope": "统编版（人教部编版）小学语文",
  "grade": 4,
  "count": 19,
  "poems": [
    {
      "id": 46,
      "title": "浪淘沙（其七）",
      "dynasty": "唐",
      "author": "刘禹锡",
      "grade": 4,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["写景", "钱塘江"],
      "lines": ["八月涛声吼地来，", "头高数丈触山回。", "须臾却入海门去，", "卷起沙堆似雪堆。"],
      "notes": [
        { "w": "八月", "t": "农历八月，钱塘江大潮的时候。" },
        { "w": "吼地", "t": "吼声震地。" },
        { "w": "触", "t": "撞击。" },
        { "w": "须臾", "t": "片刻、一会儿。" },
        { "w": "海门", "t": "江流入海处。" }
      ],
      "translation": ["八月的涛声像怒吼着从地面涌来，浪头高达数丈，撞到山又折回。", "一会儿就退入海门，卷起的沙堆像雪堆一样。"]
    },
    {
      "id": 47,
      "title": "鹿柴",
      "dynasty": "唐",
      "author": "王维",
      "grade": 4,
      "semester": "上",
      "genre": "五言绝句",
      "tags": ["山水", "写景"],
      "lines": ["空山不见人，", "但闻人语响。", "返景入深林，", "复照青苔上。"],
      "notes": [
        { "w": "鹿柴", "t": "地名，柴同“寨”，读 zhài。" },
        { "w": "但", "t": "只。" },
        { "w": "闻", "t": "听见。" },
        { "w": "返景", "t": "夕阳返照的光，景读 yǐng。" },
        { "w": "复", "t": "又。" }
      ],
      "translation": ["幽静的山谷里看不见人影，只听见有人说话的声音。", "落日的余晖返照进幽深的树林，又照在幽暗处的青苔上。"]
    },
    {
      "id": 48,
      "title": "暮江吟",
      "dynasty": "唐",
      "author": "白居易",
      "grade": 4,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["写景", "傍晚"],
      "lines": ["一道残阳铺水中，", "半江瑟瑟半江红。", "可怜九月初三夜，", "露似真珠月似弓。"],
      "notes": [
        { "w": "吟", "t": "古代诗歌的一种体裁。" },
        { "w": "残阳", "t": "夕阳。" },
        { "w": "瑟瑟", "t": "碧绿色。" },
        { "w": "可怜", "t": "可爱。" },
        { "w": "真珠", "t": "珍珠。" }
      ],
      "translation": ["一道夕阳铺在水面上，江水一半碧绿，一半艳红。", "最可爱的是九月初三的夜晚，露珠像珍珠，弯月像弓。"]
    },
    {
      "id": 49,
      "title": "题西林壁",
      "dynasty": "宋",
      "author": "苏轼",
      "grade": 4,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["哲理", "写景"],
      "lines": ["横看成岭侧成峰，", "远近高低各不同。", "不识庐山真面目，", "只缘身在此山中。"],
      "notes": [
        { "w": "题", "t": "书写。" },
        { "w": "西林", "t": "西林寺，在庐山。" },
        { "w": "横看", "t": "从正面看。" },
        { "w": "缘", "t": "因为。" },
        { "w": "真面目", "t": "真实的全貌。" }
      ],
      "translation": ["从正面看是连绵的山岭，从侧面看是高耸的山峰，远近高低各不相同。", "看不清庐山真正的样子，只因为自己身处这座山中。"]
    },
    {
      "id": 50,
      "title": "雪梅",
      "dynasty": "宋",
      "author": "卢钺",
      "grade": 4,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["咏物", "哲理"],
      "lines": ["梅雪争春未肯降，", "骚人阁笔费评章。", "梅须逊雪三分白，", "雪却输梅一段香。"],
      "notes": [
        { "w": "降", "t": "服输。" },
        { "w": "骚人", "t": "诗人。" },
        { "w": "阁笔", "t": "放下笔，阁同“搁”。" },
        { "w": "评章", "t": "评议。" },
        { "w": "逊", "t": "不如、差。" }
      ],
      "translation": ["梅花和雪花都争着报告春天，谁也不肯认输，诗人放下笔来，难以评说高低。", "梅花比雪少三分洁白，雪却不如梅花有一段清香。"]
    },
    {
      "id": 51,
      "title": "嫦娥",
      "dynasty": "唐",
      "author": "李商隐",
      "grade": 4,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["神话", "抒怀"],
      "lines": ["云母屏风烛影深，", "长河渐落晓星沉。", "嫦娥应悔偷灵药，", "碧海青天夜夜心。"],
      "notes": [
        { "w": "云母屏风", "t": "用云母石装饰的屏风。" },
        { "w": "长河", "t": "银河。" },
        { "w": "晓星", "t": "晨星。" },
        { "w": "灵药", "t": "指长生不老药。" },
        { "w": "碧海青天", "t": "形容月宫清冷寂寥。" }
      ],
      "translation": ["云母屏风上烛影渐渐暗淡，银河慢慢西沉，晨星也隐没了。", "嫦娥应当后悔偷吃了灵药，如今只能夜夜面对碧海青天，孤独寂寞。"]
    },
    {
      "id": 52,
      "title": "出塞",
      "dynasty": "唐",
      "author": "王昌龄",
      "grade": 4,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["边塞", "爱国"],
      "lines": ["秦时明月汉时关，", "万里长征人未还。", "但使龙城飞将在，", "不教胡马度阴山。"],
      "notes": [
        { "w": "但使", "t": "只要。" },
        { "w": "飞将", "t": "指汉代名将李广。" },
        { "w": "不教", "t": "不让。" },
        { "w": "胡马", "t": "敌人的骑兵。" },
        { "w": "阴山", "t": "山名，在今内蒙古中部。" }
      ],
      "translation": ["依旧是秦汉时的明月和边关，万里出征的将士还没有归来。", "只要有像李广那样的名将在，就不会让敌人的骑兵越过阴山。"]
    },
    {
      "id": 53,
      "title": "凉州词（葡萄美酒夜光杯）",
      "dynasty": "唐",
      "author": "王翰",
      "grade": 4,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["边塞", "豪情"],
      "lines": ["葡萄美酒夜光杯，", "欲饮琵琶马上催。", "醉卧沙场君莫笑，", "古来征战几人回？"],
      "notes": [
        { "w": "夜光杯", "t": "精美的玉杯。" },
        { "w": "欲", "t": "将要。" },
        { "w": "琵琶马上催", "t": "马上弹起琵琶，催人出征。" },
        { "w": "沙场", "t": "战场。" }
      ],
      "translation": ["葡萄美酒盛在夜光杯里，正要举杯畅饮，马上的琵琶声已经催人出征。", "即使醉倒在战场上，你也不要笑，自古以来出征打仗的人有几个能回来？"]
    },
    {
      "id": 54,
      "title": "夏日绝句",
      "dynasty": "宋",
      "author": "李清照",
      "grade": 4,
      "semester": "上",
      "genre": "五言绝句",
      "tags": ["爱国", "咏史"],
      "lines": ["生当作人杰，", "死亦为鬼雄。", "至今思项羽，", "不肯过江东。"],
      "notes": [
        { "w": "人杰", "t": "人中的豪杰。" },
        { "w": "鬼雄", "t": "鬼中的英雄。" },
        { "w": "项羽", "t": "秦末起义军领袖，兵败后自刎于乌江。" },
        { "w": "江东", "t": "长江下游以南地区。" }
      ],
      "translation": ["活着就要做人中的豪杰，死了也要做鬼中的英雄。", "人们至今还怀念项羽，因为他兵败后不肯苟且逃回江东。"]
    },
    {
      "id": 55,
      "title": "别董大",
      "dynasty": "唐",
      "author": "高适",
      "grade": 4,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["送别", "友情"],
      "lines": ["千里黄云白日曛，", "北风吹雁雪纷纷。", "莫愁前路无知己，", "天下谁人不识君。"],
      "notes": [
        { "w": "董大", "t": "诗人的朋友董庭兰。" },
        { "w": "曛", "t": "昏暗。" },
        { "w": "知己", "t": "知心的朋友。" },
        { "w": "君", "t": "指董大。" }
      ],
      "translation": ["千里黄云遮天，太阳昏暗无光，北风吹着大雁，大雪纷纷。", "不要担心前路没有知己，天下有谁不认识你呢？"]
    },
    {
      "id": 56,
      "title": "四时田园杂兴（其二十五）",
      "dynasty": "宋",
      "author": "范成大",
      "grade": 4,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["田园", "夏天"],
      "lines": ["梅子金黄杏子肥，", "麦花雪白菜花稀。", "日长篱落无人过，", "惟有蜻蜓蛱蝶飞。"],
      "notes": [
        { "w": "杂兴", "t": "随兴而写的诗。" },
        { "w": "肥", "t": "饱满。" },
        { "w": "日长", "t": "白天变长。" },
        { "w": "篱落", "t": "篱笆。" },
        { "w": "蛱蝶", "t": "蝴蝶的一种。" }
      ],
      "translation": ["梅子金黄，杏子饱满，麦花雪白，菜花稀疏。", "白天变长了，篱笆边没有人经过，只有蜻蜓和蝴蝶在飞。"]
    },
    {
      "id": 57,
      "title": "宿新市徐公店",
      "dynasty": "宋",
      "author": "杨万里",
      "grade": 4,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["田园", "童趣"],
      "lines": ["篱落疏疏一径深，", "树头新绿未成阴。", "儿童急走追黄蝶，", "飞入菜花无处寻。"],
      "notes": [
        { "w": "宿", "t": "住宿。" },
        { "w": "徐公店", "t": "姓徐的人开的店。" },
        { "w": "篱落", "t": "篱笆。" },
        { "w": "疏疏", "t": "稀疏的样子。" },
        { "w": "径", "t": "小路。" },
        { "w": "急走", "t": "快跑。" }
      ],
      "translation": ["稀疏的篱笆旁，一条小路伸向远处，树梢的新叶还没有长成浓荫。", "孩子飞快地跑着追赶黄蝴蝶，蝴蝶飞进菜花丛中，就找不到了。"]
    },
    {
      "id": 58,
      "title": "清平乐·村居",
      "dynasty": "宋",
      "author": "辛弃疾",
      "grade": 4,
      "semester": "下",
      "genre": "词",
      "tags": ["田园", "生活"],
      "lines": ["茅檐低小，", "溪上青青草。", "醉里吴音相媚好，", "白发谁家翁媪？", "大儿锄豆溪东，", "中儿正织鸡笼。", "最喜小儿亡赖，", "溪头卧剥莲蓬。"],
      "notes": [
        { "w": "茅檐", "t": "茅屋。" },
        { "w": "吴音", "t": "吴地的方言。" },
        { "w": "相媚好", "t": "互相逗趣、取乐。" },
        { "w": "翁媪", "t": "老翁和老妇。" },
        { "w": "亡赖", "t": "同“无赖”，这里指顽皮可爱。" }
      ],
      "translation": ["茅屋又低又小，溪边长满了青草。", "带着醉意的吴地方言听起来温柔亲切，那满头白发的是谁家的老翁老妇？", "大儿子在溪东的豆地里锄草，二儿子正在编织鸡笼。", "最可爱的是小儿子，趴在溪边剥莲蓬。"]
    },
    {
      "id": 59,
      "title": "江畔独步寻花",
      "dynasty": "唐",
      "author": "杜甫",
      "grade": 4,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["写景", "春天"],
      "lines": ["黄四娘家花满蹊，", "千朵万朵压枝低。", "留连戏蝶时时舞，", "自在娇莺恰恰啼。"],
      "notes": [
        { "w": "江畔", "t": "江边。" },
        { "w": "独步", "t": "独自散步。" },
        { "w": "黄四娘", "t": "杜甫的邻居。" },
        { "w": "蹊", "t": "小路。" },
        { "w": "留连", "t": "舍不得离开。" },
        { "w": "恰恰", "t": "形容鸟鸣声和谐动听。" }
      ],
      "translation": ["黄四娘家的小路上开满了花，千朵万朵把枝条都压弯了。", "流连的蝴蝶时时飞舞，自在的黄莺恰恰啼叫。"]
    },
    {
      "id": 60,
      "title": "蜂",
      "dynasty": "唐",
      "author": "罗隐",
      "grade": 4,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["咏物", "哲理"],
      "lines": ["不论平地与山尖，", "无限风光尽被占。", "采得百花成蜜后，", "为谁辛苦为谁甜？"],
      "notes": [
        { "w": "山尖", "t": "山顶。" },
        { "w": "尽", "t": "都。" },
        { "w": "占", "t": "占据。" },
        { "w": "为", "t": "替。" }
      ],
      "translation": ["不论是平地还是山顶，凡是鲜花盛开的地方，都被蜜蜂占据了。", "采尽百花酿成蜂蜜之后，究竟是为谁辛苦，为谁酿造甘甜呢？"]
    },
    {
      "id": 61,
      "title": "独坐敬亭山",
      "dynasty": "唐",
      "author": "李白",
      "grade": 4,
      "semester": "下",
      "genre": "五言绝句",
      "tags": ["写景", "抒怀"],
      "lines": ["众鸟高飞尽，", "孤云独去闲。", "相看两不厌，", "只有敬亭山。"],
      "notes": [
        { "w": "敬亭山", "t": "在今安徽宣城。" },
        { "w": "尽", "t": "消失。" },
        { "w": "闲", "t": "悠闲。" },
        { "w": "厌", "t": "满足。" }
      ],
      "translation": ["鸟儿们高飞远去，消失不见，一片孤云也悠闲地飘走了。", "彼此相看总不厌倦的，只有我和敬亭山。"]
    },
    {
      "id": 62,
      "title": "芙蓉楼送辛渐",
      "dynasty": "唐",
      "author": "王昌龄",
      "grade": 4,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["送别", "品格"],
      "lines": ["寒雨连江夜入吴，", "平明送客楚山孤。", "洛阳亲友如相问，", "一片冰心在玉壶。"],
      "notes": [
        { "w": "芙蓉楼", "t": "在今江苏镇江。" },
        { "w": "辛渐", "t": "诗人的朋友。" },
        { "w": "平明", "t": "天刚亮的时候。" },
        { "w": "楚山", "t": "泛指长江中下游一带的山。" },
        { "w": "冰心", "t": "像冰一样纯洁的心。" },
        { "w": "玉壶", "t": "玉制的壶。" }
      ],
      "translation": ["寒雨连江，夜里笼罩着吴地，天亮时送别友人，只觉楚山孤寂。", "洛阳的亲友如果问起我，就说我的一片冰心仍在玉壶之中。"]
    },
    {
      "id": 63,
      "title": "塞下曲",
      "dynasty": "唐",
      "author": "卢纶",
      "grade": 4,
      "semester": "下",
      "genre": "五言绝句",
      "tags": ["边塞", "征战"],
      "lines": ["月黑雁飞高，", "单于夜遁逃。", "欲将轻骑逐，", "大雪满弓刀。"],
      "notes": [
        { "w": "单于", "t": "匈奴君主的称号。" },
        { "w": "遁逃", "t": "逃跑。" },
        { "w": "将", "t": "率领。" },
        { "w": "轻骑", "t": "轻装快速的骑兵。" },
        { "w": "逐", "t": "追赶。" }
      ],
      "translation": ["漆黑的夜里，大雁惊飞，单于趁着夜色逃跑。", "将军正要率领轻骑兵追赶，大雪已经落满了弓刀。"]
    },
    {
      "id": 64,
      "title": "墨梅",
      "dynasty": "元",
      "author": "王冕",
      "grade": 4,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["咏物", "品格"],
      "lines": ["我家洗砚池头树，", "朵朵花开淡墨痕。", "不要人夸好颜色，", "只留清气满乾坤。"],
      "notes": [
        { "w": "墨梅", "t": "用墨画的梅花。" },
        { "w": "洗砚池", "t": "写字画画后洗笔砚的池子。" },
        { "w": "淡墨痕", "t": "淡淡的墨迹。" },
        { "w": "清气", "t": "清香之气。" },
        { "w": "乾坤", "t": "天地。" }
      ],
      "translation": ["我家洗砚池边那棵梅树，朵朵花开都带着淡淡的墨痕。", "它不需要别人夸赞颜色好看，只愿留下清香之气充满天地。"]
    }
  ]
}
