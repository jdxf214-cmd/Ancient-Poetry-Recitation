{
  "version": "1.1",
  "scope": "统编版（人教部编版）小学语文",
  "grade": 6,
  "count": 26,
  "poems": [
    {
      "id": 87,
      "title": "宿建德江",
      "dynasty": "唐",
      "author": "孟浩然",
      "grade": 6,
      "semester": "上",
      "genre": "五言绝句",
      "tags": ["行旅", "思乡"],
      "lines": ["移舟泊烟渚，", "日暮客愁新。", "野旷天低树，", "江清月近人。"],
      "notes": [
        { "w": "建德江", "t": "新安江流经建德的一段。" },
        { "w": "泊", "t": "停船靠岸。" },
        { "w": "烟渚", "t": "烟雾笼罩的小沙洲。" },
        { "w": "客", "t": "诗人自指，旅人。" },
        { "w": "野旷", "t": "原野空旷。" }
      ],
      "translation": ["把小船停泊在烟雾笼罩的沙洲边，日落时分，旅人的愁绪又添了一层。", "原野空旷，天显得比树还低；江水清澈，月影仿佛离人很近。"]
    },
    {
      "id": 88,
      "title": "六月二十七日望湖楼醉书",
      "dynasty": "宋",
      "author": "苏轼",
      "grade": 6,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["写景", "夏天"],
      "lines": ["黑云翻墨未遮山，", "白雨跳珠乱入船。", "卷地风来忽吹散，", "望湖楼下水如天。"],
      "notes": [
        { "w": "望湖楼", "t": "在今杭州西湖边。" },
        { "w": "翻墨", "t": "像打翻的墨汁，形容乌云。" },
        { "w": "白雨", "t": "暴雨。" },
        { "w": "跳珠", "t": "跳动的珍珠，形容雨点。" },
        { "w": "卷地风", "t": "贴着地面刮的大风。" }
      ],
      "translation": ["乌云像打翻的墨汁翻滚而来，还没有遮住山，白亮的雨点就像珍珠一样乱跳进船里。", "卷地大风忽然把云雨吹散，望湖楼下的水面平静得像天空一样。"]
    },
    {
      "id": 89,
      "title": "西江月·夜行黄沙道中",
      "dynasty": "宋",
      "author": "辛弃疾",
      "grade": 6,
      "semester": "上",
      "genre": "词",
      "tags": ["田园", "夏夜"],
      "lines": ["明月别枝惊鹊，", "清风半夜鸣蝉。", "稻花香里说丰年，", "听取蛙声一片。", "七八个星天外，", "两三点雨山前。", "旧时茅店社林边，", "路转溪桥忽见。"],
      "notes": [
        { "w": "别枝", "t": "横斜的树枝。" },
        { "w": "惊鹊", "t": "惊飞喜鹊。" },
        { "w": "社林", "t": "社庙旁的树林。" },
        { "w": "见", "t": "同“现”，出现。" }
      ],
      "translation": ["明月升起，惊飞了枝头的鹊鸟，清风吹来，半夜里传来蝉鸣。", "稻花香中，人们谈论着丰收的年景，耳边是一片蛙声。", "天边挂着七八颗星，山前落下两三点雨。", "从前社林边的茅店，转过溪桥，忽然出现在眼前。"]
    },
    {
      "id": 90,
      "title": "过故人庄",
      "dynasty": "唐",
      "author": "孟浩然",
      "grade": 6,
      "semester": "上",
      "genre": "五言律诗",
      "tags": ["田园", "友情"],
      "lines": ["故人具鸡黍，", "邀我至田家。", "绿树村边合，", "青山郭外斜。", "开轩面场圃，", "把酒话桑麻。", "待到重阳日，", "还来就菊花。"],
      "notes": [
        { "w": "过", "t": "拜访。" },
        { "w": "具", "t": "准备。" },
        { "w": "鸡黍", "t": "鸡肉和黄米饭。" },
        { "w": "合", "t": "环绕。" },
        { "w": "郭", "t": "外城。" },
        { "w": "场圃", "t": "打谷场和菜园。" },
        { "w": "就", "t": "靠近、欣赏。" }
      ],
      "translation": ["老朋友准备了饭菜，邀请我到他的农家做客。", "绿树环绕着村庄，青山在城外斜斜延伸。", "打开窗子，面对打谷场和菜园，端起酒杯，谈论桑麻农事。", "等到重阳节那天，我还要再来赏菊。"]
    },
    {
      "id": 91,
      "title": "春日",
      "dynasty": "宋",
      "author": "朱熹",
      "grade": 6,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["春天", "哲理"],
      "lines": ["胜日寻芳泗水滨，", "无边光景一时新。", "等闲识得东风面，", "万紫千红总是春。"],
      "notes": [
        { "w": "胜日", "t": "天气晴朗的好日子。" },
        { "w": "寻芳", "t": "游春赏花。" },
        { "w": "泗水", "t": "河名，在今山东。" },
        { "w": "光景", "t": "风光景色。" },
        { "w": "等闲", "t": "平常、轻易。" },
        { "w": "东风", "t": "春风。" }
      ],
      "translation": ["在风和日丽的日子到泗水边游春，无边无际的风光一下子焕然一新。", "很容易就能认出春风的面貌，万紫千红，都是春天。"]
    },
    {
      "id": 92,
      "title": "回乡偶书",
      "dynasty": "唐",
      "author": "贺知章",
      "grade": 6,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["思乡", "感怀"],
      "lines": ["少小离家老大回，", "乡音无改鬓毛衰。", "儿童相见不相识，", "笑问客从何处来。"],
      "notes": [
        { "w": "偶书", "t": "随意写下。" },
        { "w": "少小", "t": "年少时。" },
        { "w": "老大", "t": "年老时。" },
        { "w": "乡音", "t": "家乡的口音。" },
        { "w": "鬓毛衰", "t": "鬓发稀疏变白。" }
      ],
      "translation": ["年少时离开家乡，年老才回来，乡音没有改变，鬓发却已经稀疏变白。", "孩子们见了我都不认识，笑着问我是从哪里来的客人。"]
    },
    {
      "id": 93,
      "title": "浪淘沙（其一）",
      "dynasty": "唐",
      "author": "刘禹锡",
      "grade": 6,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["写景", "黄河"],
      "lines": ["九曲黄河万里沙，", "浪淘风簸自天涯。", "如今直上银河去，", "同到牵牛织女家。"],
      "notes": [
        { "w": "九曲", "t": "形容弯曲很多。" },
        { "w": "簸", "t": "颠簸。" },
        { "w": "天涯", "t": "天边。" },
        { "w": "牵牛织女", "t": "银河两边的星。" }
      ],
      "translation": ["九曲黄河挟带着万里黄沙，波涛翻滚，狂风颠簸，仿佛来自天边。", "如今我要沿着黄河直上银河，一同到牵牛织女的家中去。"]
    },
    {
      "id": 94,
      "title": "江南春",
      "dynasty": "唐",
      "author": "杜牧",
      "grade": 6,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["写景", "江南"],
      "lines": ["千里莺啼绿映红，", "水村山郭酒旗风。", "南朝四百八十寺，", "多少楼台烟雨中。"],
      "notes": [
        { "w": "山郭", "t": "山边的城郭。" },
        { "w": "酒旗", "t": "酒家的幌子。" },
        { "w": "南朝", "t": "宋、齐、梁、陈四朝。" },
        { "w": "四百八十寺", "t": "形容寺庙很多。" },
        { "w": "楼台", "t": "这里指寺庙建筑。" }
      ],
      "translation": ["千里江南，黄莺啼叫，绿树映着红花；水边的村庄、山边的城郭，酒旗迎风飘扬。", "南朝留下的四百八十座寺庙，有多少楼台笼罩在烟雨之中。"]
    },
    {
      "id": 95,
      "title": "书湖阴先生壁",
      "dynasty": "宋",
      "author": "王安石",
      "grade": 6,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["写景", "田园"],
      "lines": ["茅檐长扫净无苔，", "花木成畦手自栽。", "一水护田将绿绕，", "两山排闼送青来。"],
      "notes": [
        { "w": "湖阴先生", "t": "杨德逢，王安石的朋友。" },
        { "w": "茅檐", "t": "茅屋的屋檐，这里指庭院。" },
        { "w": "畦", "t": "田园中分成的小块土地。" },
        { "w": "护田", "t": "护卫农田。" },
        { "w": "排闼", "t": "推开门。闼，小门。" }
      ],
      "translation": ["庭院经常打扫，干净得没有青苔，花木成畦，都是主人亲手栽种。", "一条溪水护卫着农田，绕着绿意流淌；两座青山推门而入，送来青色。"]
    },
    {
      "id": 96,
      "title": "寒食",
      "dynasty": "唐",
      "author": "韩翃",
      "grade": 6,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["节日", "讽喻"],
      "lines": ["春城无处不飞花，", "寒食东风御柳斜。", "日暮汉宫传蜡烛，", "轻烟散入五侯家。"],
      "notes": [
        { "w": "寒食", "t": "寒食节，清明前一二日。" },
        { "w": "春城", "t": "春天的京城。" },
        { "w": "御柳", "t": "皇家宫苑中的柳树。" },
        { "w": "汉宫", "t": "这里借指唐朝皇宫。" },
        { "w": "五侯", "t": "泛指权贵近臣。" }
      ],
      "translation": ["暮春的长安城里，处处飞花，寒食节的东风把宫中的柳枝吹斜。", "傍晚，宫里传出赐烛的火种，轻烟散入权贵之家。"]
    },
    {
      "id": 97,
      "title": "迢迢牵牛星",
      "dynasty": "汉",
      "author": "佚名",
      "grade": 6,
      "semester": "下",
      "genre": "五言古诗",
      "tags": ["神话", "相思"],
      "lines": ["迢迢牵牛星，", "皎皎河汉女。", "纤纤擢素手，", "札札弄机杼。", "终日不成章，", "泣涕零如雨。", "河汉清且浅，", "相去复几许？", "盈盈一水间，", "脉脉不得语。"],
      "notes": [
        { "w": "迢迢", "t": "遥远的样子。" },
        { "w": "皎皎", "t": "明亮的样子。" },
        { "w": "擢", "t": "伸出。" },
        { "w": "机杼", "t": "织布机。" },
        { "w": "章", "t": "布匹。" },
        { "w": "脉脉", "t": "含情相视的样子。" }
      ],
      "translation": ["遥远的牵牛星，明亮的织女星。", "织女伸出纤细洁白的手，札札地摆弄着织布机。", "一整天也织不成一匹布，眼泪像雨一样落下。", "银河又清又浅，相隔又能有多远？", "只隔着一条清澈的水，却只能含情相望，不能说话。"]
    },
    {
      "id": 98,
      "title": "十五夜望月",
      "dynasty": "唐",
      "author": "王建",
      "grade": 6,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["中秋", "思乡"],
      "lines": ["中庭地白树栖鸦，", "冷露无声湿桂花。", "今夜月明人尽望，", "不知秋思落谁家。"],
      "notes": [
        { "w": "十五夜", "t": "农历八月十五中秋夜。" },
        { "w": "中庭", "t": "庭院中。" },
        { "w": "地白", "t": "月光照在地上，一片洁白。" },
        { "w": "冷露", "t": "清冷的露水。" },
        { "w": "秋思", "t": "秋天的情思。" }
      ],
      "translation": ["庭院中月光铺地，一片洁白，树上栖息着乌鸦，清冷的露水悄悄打湿了桂花。", "今夜明月当空，人人都在仰望，不知这秋天的思念落在谁家。"]
    },
    {
      "id": 99,
      "title": "长歌行",
      "dynasty": "汉",
      "author": "汉乐府",
      "grade": 6,
      "semester": "下",
      "genre": "乐府诗",
      "tags": ["惜时", "哲理"],
      "lines": ["青青园中葵，", "朝露待日晞。", "阳春布德泽，", "万物生光辉。", "常恐秋节至，", "焜黄华叶衰。", "百川东到海，", "何时复西归？", "少壮不努力，", "老大徒伤悲。"],
      "notes": [
        { "w": "葵", "t": "葵菜。" },
        { "w": "晞", "t": "晒干。" },
        { "w": "布德泽", "t": "散布恩泽。" },
        { "w": "焜黄", "t": "枯黄。" },
        { "w": "华叶衰", "t": "花叶衰败。华，同“花”。" },
        { "w": "徒", "t": "白白地。" }
      ],
      "translation": ["园中青青的葵菜，清晨的露水等着太阳晒干。", "温暖的春天施予恩泽，万物都焕发光辉。", "常常担心秋天到来，花叶枯黄衰败。", "百条江河向东流入大海，什么时候才能再向西流回？", "年轻时不努力，年老时就只能白白伤悲。"]
    },
    {
      "id": 100,
      "title": "马诗",
      "dynasty": "唐",
      "author": "李贺",
      "grade": 6,
      "semester": "下",
      "genre": "五言绝句",
      "tags": ["咏物", "言志"],
      "lines": ["大漠沙如雪，", "燕山月似钩。", "何当金络脑，", "快走踏清秋。"],
      "notes": [
        { "w": "大漠", "t": "广阔的沙漠。" },
        { "w": "燕山", "t": "山名，这里泛指边塞。" },
        { "w": "钩", "t": "弯刀。" },
        { "w": "何当", "t": "什么时候。" },
        { "w": "金络脑", "t": "用黄金装饰的马笼头。" }
      ],
      "translation": ["大漠的沙像雪一样白，燕山的月像弯钩。", "什么时候才能戴上金络脑，在清爽的秋日里奔驰？"]
    },
    {
      "id": 101,
      "title": "石灰吟",
      "dynasty": "明",
      "author": "于谦",
      "grade": 6,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["咏物", "品格"],
      "lines": ["千锤万凿出深山，", "烈火焚烧若等闲。", "粉骨碎身浑不怕，", "要留清白在人间。"],
      "notes": [
        { "w": "吟", "t": "诗歌的一种体裁。" },
        { "w": "千锤万凿", "t": "无数次锤打开凿。" },
        { "w": "等闲", "t": "平常。" },
        { "w": "浑", "t": "全、都。" },
        { "w": "清白", "t": "石灰的白色，也指清白的人格。" }
      ],
      "translation": ["石灰经过千锤万凿才从深山中开采出来，烈火焚烧也看作平常。", "即使粉身碎骨也全然不怕，只要把清白留在人世间。"]
    },
    {
      "id": 102,
      "title": "竹石",
      "dynasty": "清",
      "author": "郑燮",
      "grade": 6,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["咏物", "品格"],
      "lines": ["咬定青山不放松，", "立根原在破岩中。", "千磨万击还坚劲，", "任尔东西南北风。"],
      "notes": [
        { "w": "咬定", "t": "紧紧咬住。" },
        { "w": "立根", "t": "扎根。" },
        { "w": "破岩", "t": "破裂的岩石。" },
        { "w": "坚劲", "t": "坚韧挺拔。" },
        { "w": "任尔", "t": "任凭你。" }
      ],
      "translation": ["竹子紧紧咬住青山不放松，根原本就扎在破裂的岩石中。", "经历千万次磨难打击仍然坚韧挺拔，任凭你东西南北四面来风。"]
    },
    {
      "id": 103,
      "title": "采薇（节选）",
      "dynasty": "先秦",
      "author": "佚名",
      "grade": 6,
      "semester": "下",
      "genre": "诗经",
      "tags": ["戍边", "思乡"],
      "lines": ["昔我往矣，", "杨柳依依。", "今我来思，", "雨雪霏霏。"],
      "notes": [
        { "w": "昔", "t": "从前。" },
        { "w": "往", "t": "出征。" },
        { "w": "依依", "t": "柳枝轻拂的样子。" },
        { "w": "雨雪", "t": "下雪。雨读 yù，作动词。" },
        { "w": "霏霏", "t": "雪花纷飞的样子。" }
      ],
      "translation": ["从前我出征的时候，杨柳轻轻飘拂。", "如今我回来了，大雪纷纷扬扬。"]
    },
    {
      "id": 104,
      "title": "送元二使安西",
      "dynasty": "唐",
      "author": "王维",
      "grade": 6,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["送别", "友情"],
      "lines": ["渭城朝雨浥轻尘，", "客舍青青柳色新。", "劝君更尽一杯酒，", "西出阳关无故人。"],
      "notes": [
        { "w": "元二", "t": "诗人的朋友。" },
        { "w": "使", "t": "出使。" },
        { "w": "渭城", "t": "在今陕西咸阳。" },
        { "w": "浥", "t": "湿润。" },
        { "w": "更尽", "t": "再饮完。" },
        { "w": "阳关", "t": "在今甘肃敦煌。" }
      ],
      "translation": ["渭城清晨的细雨湿润了轻尘，客舍旁的柳树一片青翠，格外清新。", "劝你再饮完这一杯酒，向西出了阳关，就再也没有老朋友了。"]
    },
    {
      "id": 105,
      "title": "春夜喜雨",
      "dynasty": "唐",
      "author": "杜甫",
      "grade": 6,
      "semester": "下",
      "genre": "五言律诗",
      "tags": ["写景", "春天"],
      "lines": ["好雨知时节，", "当春乃发生。", "随风潜入夜，", "润物细无声。", "野径云俱黑，", "江船火独明。", "晓看红湿处，", "花重锦官城。"],
      "notes": [
        { "w": "乃", "t": "就。" },
        { "w": "发生", "t": "萌发生长。" },
        { "w": "潜", "t": "悄悄地。" },
        { "w": "润物", "t": "滋润万物。" },
        { "w": "俱", "t": "都。" },
        { "w": "花重", "t": "花因饱含雨水而沉重。" },
        { "w": "锦官城", "t": "成都的别称。" }
      ],
      "translation": ["好雨知道下雨的节令，正当春天就降临了。", "它随着春风悄悄飘入夜色，无声地滋润着万物。", "田野小路上乌云一片漆黑，只有江上渔船的一点灯火明亮。", "天亮后去看那被雨打湿的红花，成都城里花团锦簇，沉甸甸的。"]
    },
    {
      "id": 106,
      "title": "早春呈水部张十八员外",
      "dynasty": "唐",
      "author": "韩愈",
      "grade": 6,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["写景", "早春"],
      "lines": ["天街小雨润如酥，", "草色遥看近却无。", "最是一年春好处，", "绝胜烟柳满皇都。"],
      "notes": [
        { "w": "呈", "t": "恭敬地送上。" },
        { "w": "天街", "t": "京城的街道。" },
        { "w": "酥", "t": "酥油，形容春雨滋润。" },
        { "w": "绝胜", "t": "远远胜过。" },
        { "w": "皇都", "t": "京城。" }
      ],
      "translation": ["京城街道上细雨滋润如酥油，远看草色青青，近看却好像没有。", "这是一年中最美的春景，远远胜过满城烟柳的暮春。"]
    },
    {
      "id": 107,
      "title": "江上渔者",
      "dynasty": "宋",
      "author": "范仲淹",
      "grade": 6,
      "semester": "下",
      "genre": "五言绝句",
      "tags": ["劳动", "民生"],
      "lines": ["江上往来人，", "但爱鲈鱼美。", "君看一叶舟，", "出没风波里。"],
      "notes": [
        { "w": "渔者", "t": "捕鱼的人。" },
        { "w": "但", "t": "只。" },
        { "w": "鲈鱼", "t": "一种味道鲜美的鱼。" },
        { "w": "一叶舟", "t": "形容小船。" },
        { "w": "出没", "t": "时隐时现。" }
      ],
      "translation": ["江上来来往往的人，只喜爱鲈鱼的味道鲜美。", "你看那一叶小舟，在风浪中时隐时现。"]
    },
    {
      "id": 108,
      "title": "泊船瓜洲",
      "dynasty": "宋",
      "author": "王安石",
      "grade": 6,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["思乡", "行旅"],
      "lines": ["京口瓜洲一水间，", "钟山只隔数重山。", "春风又绿江南岸，", "明月何时照我还。"],
      "notes": [
        { "w": "泊", "t": "停船靠岸。" },
        { "w": "瓜洲", "t": "在今江苏扬州南。" },
        { "w": "京口", "t": "今江苏镇江。" },
        { "w": "一水间", "t": "只隔一条江。" },
        { "w": "钟山", "t": "今南京紫金山。" },
        { "w": "绿", "t": "吹绿，作动词。" }
      ],
      "translation": ["京口和瓜洲之间只隔着一条长江，钟山也只隔着几座山。", "春风又吹绿了江南岸边，明月什么时候才能照着我回家呢？"]
    },
    {
      "id": 109,
      "title": "游园不值",
      "dynasty": "宋",
      "author": "叶绍翁",
      "grade": 6,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["写景", "春天"],
      "lines": ["应怜屐齿印苍苔，", "小扣柴扉久不开。", "春色满园关不住，", "一枝红杏出墙来。"],
      "notes": [
        { "w": "不值", "t": "没有遇到人。" },
        { "w": "应怜", "t": "大概是爱惜。" },
        { "w": "屐齿", "t": "木屐底下的齿。" },
        { "w": "苍苔", "t": "青苔。" },
        { "w": "小扣", "t": "轻轻敲。" },
        { "w": "柴扉", "t": "柴门。" }
      ],
      "translation": ["大概是主人爱惜青苔，怕木屐踩出脚印，我轻轻敲着柴门，久久没有人来开。", "满园的春色关也关不住，一枝红杏伸出墙头来。"]
    },
    {
      "id": 110,
      "title": "卜算子·送鲍浩然之浙东",
      "dynasty": "宋",
      "author": "王观",
      "grade": 6,
      "semester": "下",
      "genre": "词",
      "tags": ["送别", "友情"],
      "lines": ["水是眼波横，", "山是眉峰聚。", "欲问行人去那边？", "眉眼盈盈处。", "才始送春归，", "又送君归去。", "若到江南赶上春，", "千万和春住。"],
      "notes": [
        { "w": "之", "t": "往、到。" },
        { "w": "浙东", "t": "浙江东部。" },
        { "w": "眼波", "t": "形容目光像水波。" },
        { "w": "眉峰", "t": "形容眉毛像山峰。" },
        { "w": "盈盈", "t": "美好的样子。" },
        { "w": "才始", "t": "刚刚。" }
      ],
      "translation": ["水像美人流动的眼波，山像美人蹙起的眉峰。", "要问远行的人去哪里？就去那山水如眉眼般美好的地方。", "刚刚送走春天，又要送你归去。", "如果到了江南还能赶上春天，千万要和春天同住。"]
    },
    {
      "id": 111,
      "title": "浣溪沙",
      "dynasty": "宋",
      "author": "苏轼",
      "grade": 6,
      "semester": "下",
      "genre": "词",
      "tags": ["写景", "哲理"],
      "lines": ["山下兰芽短浸溪，", "松间沙路净无泥。", "萧萧暮雨子规啼。", "谁道人生无再少？", "门前流水尚能西！", "休将白发唱黄鸡。"],
      "notes": [
        { "w": "蕲水", "t": "今湖北浠水。" },
        { "w": "兰芽", "t": "兰草的嫩芽。" },
        { "w": "萧萧", "t": "雨声。" },
        { "w": "子规", "t": "杜鹃鸟。" },
        { "w": "再少", "t": "再年轻。" },
        { "w": "黄鸡", "t": "黄鸡报晓，感叹时光流逝。" }
      ],
      "translation": ["山脚下的兰草嫩芽浸在溪水中，松林间的沙路干净没有泥。", "傍晚细雨萧萧，杜鹃啼叫。", "谁说人生不能再年轻？门前的流水还能向西流！", "不要因为年老就哀叹时光飞逝。"]
    },
    {
      "id": 112,
      "title": "清平乐（春归何处）",
      "dynasty": "宋",
      "author": "黄庭坚",
      "grade": 6,
      "semester": "下",
      "genre": "词",
      "tags": ["惜春", "抒怀"],
      "lines": ["春归何处？", "寂寞无行路。", "若有人知春去处，", "唤取归来同住。", "春无踪迹谁知？", "除非问取黄鹂。", "百啭无人能解，", "因风飞过蔷薇。"],
      "notes": [
        { "w": "无行路", "t": "没有留下回去的路。" },
        { "w": "唤取", "t": "唤来。" },
        { "w": "问取", "t": "问一问。" },
        { "w": "百啭", "t": "鸟鸣婉转多样。" },
        { "w": "因风", "t": "顺着风。" }
      ],
      "translation": ["春天回到哪里去了？静悄悄的，没有留下回去的路。", "如果有人知道春天的去处，就把它唤回来同住。", "春天没有踪迹，谁知道呢？除非去问黄鹂。", "黄鹂婉转啼鸣，却没人能听懂，它顺着风飞过蔷薇花丛。"]
    }
  ]
}
