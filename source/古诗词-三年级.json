{
  "version": "1.1",
  "scope": "统编版（人教部编版）小学语文",
  "grade": 3,
  "count": 18,
  "poems": [
    {
      "id": 28,
      "title": "所见",
      "dynasty": "清",
      "author": "袁枚",
      "grade": 3,
      "semester": "上",
      "genre": "五言绝句",
      "tags": ["童趣", "叙事"],
      "lines": ["牧童骑黄牛，", "歌声振林樾。", "意欲捕鸣蝉，", "忽然闭口立。"],
      "notes": [
        { "w": "振", "t": "振荡、回荡。" },
        { "w": "林樾", "t": "树林。樾，树荫。" },
        { "w": "意欲", "t": "想要。" },
        { "w": "捕", "t": "捕捉。" }
      ],
      "translation": ["牧童骑在黄牛背上，响亮的歌声在树林里回荡。", "他忽然想要捕捉鸣叫的蝉，就闭上嘴，一动不动地站住了。"]
    },
    {
      "id": 29,
      "title": "山行",
      "dynasty": "唐",
      "author": "杜牧",
      "grade": 3,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["写景", "秋天"],
      "lines": ["远上寒山石径斜，", "白云生处有人家。", "停车坐爱枫林晚，", "霜叶红于二月花。"],
      "notes": [
        { "w": "寒山", "t": "深秋时节的山。" },
        { "w": "石径", "t": "石头铺成的小路。" },
        { "w": "斜", "t": "倾斜，这里形容山路弯弯曲曲。" },
        { "w": "生", "t": "产生、升起。" },
        { "w": "坐", "t": "因为。" },
        { "w": "霜叶", "t": "经霜的枫叶。" },
        { "w": "于", "t": "比。" }
      ],
      "translation": ["沿着弯弯曲曲的石径登上深秋的山，白云升起的地方住着人家。", "停下车来，是因为喜爱傍晚的枫林，经霜的枫叶比二月的春花还要红。"]
    },
    {
      "id": 30,
      "title": "赠刘景文",
      "dynasty": "宋",
      "author": "苏轼",
      "grade": 3,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["赠友", "秋天"],
      "lines": ["荷尽已无擎雨盖，", "菊残犹有傲霜枝。", "一年好景君须记，", "最是橙黄橘绿时。"],
      "notes": [
        { "w": "荷尽", "t": "荷花凋谢。" },
        { "w": "擎雨盖", "t": "指荷叶，像撑起的伞盖。" },
        { "w": "菊残", "t": "菊花凋残。" },
        { "w": "傲霜枝", "t": "不畏寒霜的菊枝。" },
        { "w": "君须记", "t": "你要记住。君，对对方的尊称。" }
      ],
      "translation": ["荷花凋谢了，再没有撑雨的荷叶；菊花残了，仍有不怕寒霜的枝条。", "一年中最好的景致你要记住，就是这橙子金黄、橘子青绿的时节。"]
    },
    {
      "id": 31,
      "title": "夜书所见",
      "dynasty": "宋",
      "author": "叶绍翁",
      "grade": 3,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["思乡", "秋天"],
      "lines": ["萧萧梧叶送寒声，", "江上秋风动客情。", "知有儿童挑促织，", "夜深篱落一灯明。"],
      "notes": [
        { "w": "萧萧", "t": "风吹树叶的声音。" },
        { "w": "梧叶", "t": "梧桐叶。" },
        { "w": "客情", "t": "旅人的思乡之情。" },
        { "w": "挑", "t": "用细长的东西拨弄。" },
        { "w": "促织", "t": "蟋蟀。" },
        { "w": "篱落", "t": "篱笆。" }
      ],
      "translation": ["梧桐叶萧萧作响，送来阵阵寒意，江上的秋风触动了旅人的思乡之情。", "料想是孩子们在捉蟋蟀，夜深了，篱笆边还亮着一盏灯。"]
    },
    {
      "id": 32,
      "title": "望天门山",
      "dynasty": "唐",
      "author": "李白",
      "grade": 3,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["写景", "山水"],
      "lines": ["天门中断楚江开，", "碧水东流至此回。", "两岸青山相对出，", "孤帆一片日边来。"],
      "notes": [
        { "w": "天门山", "t": "在今安徽当涂，夹江对峙。" },
        { "w": "中断", "t": "从中间断开。" },
        { "w": "楚江", "t": "长江流经楚地的一段。" },
        { "w": "回", "t": "回旋、掉转。" },
        { "w": "出", "t": "耸出、出现。" },
        { "w": "日边", "t": "太阳升起的地方。" }
      ],
      "translation": ["天门山从中间断开，楚江奔涌而出，碧绿的江水东流到这里回旋。", "两岸青山相对耸立，一叶孤帆从太阳升起的地方驶来。"]
    },
    {
      "id": 33,
      "title": "饮湖上初晴后雨",
      "dynasty": "宋",
      "author": "苏轼",
      "grade": 3,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["写景", "西湖"],
      "lines": ["水光潋滟晴方好，", "山色空蒙雨亦奇。", "欲把西湖比西子，", "淡妆浓抹总相宜。"],
      "notes": [
        { "w": "潋滟", "t": "水波荡漾、波光闪动的样子。" },
        { "w": "方好", "t": "正好。" },
        { "w": "空蒙", "t": "云雾迷茫的样子。" },
        { "w": "西子", "t": "西施，春秋时越国美女。" },
        { "w": "相宜", "t": "合适。" }
      ],
      "translation": ["晴天里湖水波光闪动，正是美好；雨中山色云雾迷茫，也很奇妙。", "要把西湖比作美人西施，淡妆也好，浓妆也好，总是那么合适。"]
    },
    {
      "id": 34,
      "title": "望洞庭",
      "dynasty": "唐",
      "author": "刘禹锡",
      "grade": 3,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["写景", "秋天"],
      "lines": ["湖光秋月两相和，", "潭面无风镜未磨。", "遥望洞庭山水翠，", "白银盘里一青螺。"],
      "notes": [
        { "w": "和", "t": "和谐、融合。" },
        { "w": "镜未磨", "t": "未经打磨的铜镜，形容湖面朦胧。" },
        { "w": "遥望", "t": "远远地看。" },
        { "w": "青螺", "t": "青螺髻，这里比喻君山。" }
      ],
      "translation": ["湖光与秋月相互交融，湖面没有风，像一面未经打磨的铜镜。", "远远望去，洞庭湖的山水一片青翠，就像白银盘里放着一只青螺。"]
    },
    {
      "id": 35,
      "title": "早发白帝城",
      "dynasty": "唐",
      "author": "李白",
      "grade": 3,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["写景", "行旅"],
      "lines": ["朝辞白帝彩云间，", "千里江陵一日还。", "两岸猿声啼不住，", "轻舟已过万重山。"],
      "notes": [
        { "w": "发", "t": "出发。" },
        { "w": "白帝城", "t": "在今重庆奉节。" },
        { "w": "朝辞", "t": "早晨告别。" },
        { "w": "还", "t": "返回。" },
        { "w": "万重山", "t": "层层叠叠的山。" }
      ],
      "translation": ["清晨告别彩云环绕的白帝城，千里之外的江陵一天就能到达。", "两岸猿声还在耳边啼叫不停，轻快的小船已经越过了万重山。"]
    },
    {
      "id": 36,
      "title": "采莲曲",
      "dynasty": "唐",
      "author": "王昌龄",
      "grade": 3,
      "semester": "上",
      "genre": "七言绝句",
      "tags": ["写景", "采莲"],
      "lines": ["荷叶罗裙一色裁，", "芙蓉向脸两边开。", "乱入池中看不见，", "闻歌始觉有人来。"],
      "notes": [
        { "w": "罗裙", "t": "丝罗做的裙子。" },
        { "w": "一色", "t": "同一种颜色。" },
        { "w": "芙蓉", "t": "荷花。" },
        { "w": "乱入", "t": "混入。" },
        { "w": "始", "t": "才。" }
      ],
      "translation": ["荷叶和采莲女的罗裙像是用同一种颜色裁成的，荷花朝着她的脸庞两边盛开。", "她混入荷池中就看不见了，听到歌声才发觉有人来。"]
    },
    {
      "id": 37,
      "title": "绝句（迟日江山丽）",
      "dynasty": "唐",
      "author": "杜甫",
      "grade": 3,
      "semester": "下",
      "genre": "五言绝句",
      "tags": ["写景", "春天"],
      "lines": ["迟日江山丽，", "春风花草香。", "泥融飞燕子，", "沙暖睡鸳鸯。"],
      "notes": [
        { "w": "迟日", "t": "春日，春天白昼渐长。" },
        { "w": "泥融", "t": "泥土湿润松软。" },
        { "w": "鸳鸯", "t": "一种水鸟，常成对出现。" }
      ],
      "translation": ["春日照耀下，江山格外秀丽，春风送来花草的芳香。", "泥土湿润松软，燕子在飞来飞去衔泥筑巢；沙滩温暖，鸳鸯成对安睡。"]
    },
    {
      "id": 38,
      "title": "惠崇春江晚景",
      "dynasty": "宋",
      "author": "苏轼",
      "grade": 3,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["题画", "春天"],
      "lines": ["竹外桃花三两枝，", "春江水暖鸭先知。", "蒌蒿满地芦芽短，", "正是河豚欲上时。"],
      "notes": [
        { "w": "惠崇", "t": "北宋僧人，画家。" },
        { "w": "蒌蒿", "t": "一种野生的草。" },
        { "w": "芦芽", "t": "芦苇的嫩芽。" },
        { "w": "河豚", "t": "一种鱼，春天逆流而上。" }
      ],
      "translation": ["竹林外开着两三枝桃花，春江水暖，鸭子最先知道。", "蒌蒿长满河滩，芦笋才冒出短短的嫩芽，正是河豚逆流而上的时候。"]
    },
    {
      "id": 39,
      "title": "三衢道中",
      "dynasty": "宋",
      "author": "曾几",
      "grade": 3,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["写景", "行旅"],
      "lines": ["梅子黄时日日晴，", "小溪泛尽却山行。", "绿阴不减来时路，", "添得黄鹂四五声。"],
      "notes": [
        { "w": "三衢", "t": "三衢山，在今浙江衢州。" },
        { "w": "泛", "t": "乘船。" },
        { "w": "尽", "t": "尽头。" },
        { "w": "却", "t": "再、又。" },
        { "w": "阴", "t": "树荫。" }
      ],
      "translation": ["梅子黄熟的时候，天天都是晴天，乘船到了小溪尽头，又改走山路。", "一路上的绿荫不比来时少，还多了四五声黄鹂的鸣叫。"]
    },
    {
      "id": 40,
      "title": "忆江南",
      "dynasty": "唐",
      "author": "白居易",
      "grade": 3,
      "semester": "下",
      "genre": "词",
      "tags": ["江南", "怀念"],
      "lines": ["江南好，", "风景旧曾谙。", "日出江花红胜火，", "春来江水绿如蓝。", "能不忆江南？"],
      "notes": [
        { "w": "谙", "t": "熟悉。" },
        { "w": "江花", "t": "江边的花。" },
        { "w": "蓝", "t": "蓝草，可制青绿色染料。" }
      ],
      "translation": ["江南真好，那里的风景我从前就很熟悉。", "太阳升起时，江边的花红得胜过火焰；春天到来时，江水绿得像蓝草一样。", "怎么能不怀念江南呢？"]
    },
    {
      "id": 41,
      "title": "元日",
      "dynasty": "宋",
      "author": "王安石",
      "grade": 3,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["节日", "民俗"],
      "lines": ["爆竹声中一岁除，", "春风送暖入屠苏。", "千门万户曈曈日，", "总把新桃换旧符。"],
      "notes": [
        { "w": "元日", "t": "农历正月初一，即春节。" },
        { "w": "一岁除", "t": "一年过去了。除，逝去。" },
        { "w": "屠苏", "t": "屠苏酒，古人春节时饮用的酒。" },
        { "w": "曈曈", "t": "太阳明亮的样子。" },
        { "w": "桃符", "t": "春联的前身。" }
      ],
      "translation": ["在爆竹声中，旧的一年过去了，春风送暖，人们喝着屠苏酒。", "旭日照亮千家万户，人人都把新的桃符换下旧的。"]
    },
    {
      "id": 42,
      "title": "清明",
      "dynasty": "唐",
      "author": "杜牧",
      "grade": 3,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["节日", "写景"],
      "lines": ["清明时节雨纷纷，", "路上行人欲断魂。", "借问酒家何处有？", "牧童遥指杏花村。"],
      "notes": [
        { "w": "清明", "t": "节气名，也是节日。" },
        { "w": "纷纷", "t": "多而杂乱。" },
        { "w": "行人", "t": "出门在外的人。" },
        { "w": "断魂", "t": "形容极度伤感。" },
        { "w": "借问", "t": "请问。" }
      ],
      "translation": ["清明时节，细雨纷纷，路上的行人心情愁苦，像丢了魂一样。", "问哪里有酒家，牧童远远地指向杏花深处的村庄。"]
    },
    {
      "id": 43,
      "title": "九月九日忆山东兄弟",
      "dynasty": "唐",
      "author": "王维",
      "grade": 3,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["思乡", "节日"],
      "lines": ["独在异乡为异客，", "每逢佳节倍思亲。", "遥知兄弟登高处，", "遍插茱萸少一人。"],
      "notes": [
        { "w": "山东", "t": "华山以东，指诗人的家乡。" },
        { "w": "异乡", "t": "他乡。" },
        { "w": "倍", "t": "更加。" },
        { "w": "登高", "t": "重阳节的习俗。" },
        { "w": "茱萸", "t": "一种有香气的植物，重阳节佩戴。" }
      ],
      "translation": ["独自在他乡做客，每逢佳节就更加思念亲人。", "遥想兄弟们登高的时候，人人身上插着茱萸，却少了我一个人。"]
    },
    {
      "id": 44,
      "title": "滁州西涧",
      "dynasty": "唐",
      "author": "韦应物",
      "grade": 3,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["写景", "山水"],
      "lines": ["独怜幽草涧边生，", "上有黄鹂深树鸣。", "春潮带雨晚来急，", "野渡无人舟自横。"],
      "notes": [
        { "w": "独怜", "t": "唯独喜爱。" },
        { "w": "幽草", "t": "幽深处的草。" },
        { "w": "深树", "t": "枝叶茂密的树。" },
        { "w": "野渡", "t": "荒野的渡口。" },
        { "w": "横", "t": "横浮。" }
      ],
      "translation": ["我唯独喜爱那长在涧边的幽草，树丛深处有黄鹂在鸣叫。", "傍晚春潮夹着雨水来得又急又猛，荒野渡口没有人，小船独自横在水面上。"]
    },
    {
      "id": 45,
      "title": "大林寺桃花",
      "dynasty": "唐",
      "author": "白居易",
      "grade": 3,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["写景", "春天"],
      "lines": ["人间四月芳菲尽，", "山寺桃花始盛开。", "长恨春归无觅处，", "不知转入此中来。"],
      "notes": [
        { "w": "芳菲", "t": "花草的芳香，这里指花。" },
        { "w": "始", "t": "才。" },
        { "w": "长恨", "t": "常常遗憾。" },
        { "w": "觅", "t": "寻找。" }
      ],
      "translation": ["山下四月里，花儿已经凋谢，山寺的桃花才刚刚盛开。", "常常遗憾春天归去后无处寻找，没想到它转到这里来了。"]
    }
  ]
}
