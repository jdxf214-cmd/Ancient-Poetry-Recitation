{
  "version": "1.1",
  "scope": "统编版（人教部编版）小学语文",
  "grade": 1,
  "count": 13,
  "poems": [
    {
      "id": 1,
      "title": "咏鹅",
      "dynasty": "唐",
      "author": "骆宾王",
      "grade": 1,
      "semester": "上",
      "genre": "五言古体",
      "tags": ["咏物", "动物"],
      "lines": ["鹅，鹅，鹅，", "曲项向天歌。", "白毛浮绿水，", "红掌拨清波。"],
      "notes": [
        { "w": "曲项", "t": "弯着脖子。项，脖子。" },
        { "w": "歌", "t": "这里指鹅的叫声，好像在唱歌。" },
        { "w": "拨", "t": "划动。" },
        { "w": "红掌", "t": "鹅的脚掌是红色的。" }
      ],
      "translation": ["鹅呀鹅，弯着脖子朝着天空欢叫。", "雪白的羽毛浮在碧绿的水面上，红红的脚掌拨动着清清的水波。"]
    },
    {
      "id": 2,
      "title": "江南",
      "dynasty": "汉",
      "author": "汉乐府",
      "grade": 1,
      "semester": "上",
      "genre": "乐府诗",
      "tags": ["写景", "江南"],
      "lines": ["江南可采莲，", "莲叶何田田。", "鱼戏莲叶间。", "鱼戏莲叶东，", "鱼戏莲叶西，", "鱼戏莲叶南，", "鱼戏莲叶北。"],
      "notes": [
        { "w": "何", "t": "多么。" },
        { "w": "田田", "t": "莲叶茂盛相连的样子。" },
        { "w": "戏", "t": "嬉戏、游玩。" },
        { "w": "间", "t": "中间。" }
      ],
      "translation": ["江南又到了可以采莲的时候，莲叶长得多么茂盛相连。", "鱼儿在莲叶间游来游去，一会儿游到东，一会儿游到西，一会儿游到南，一会儿游到北。"]
    },
    {
      "id": 3,
      "title": "画",
      "dynasty": "唐",
      "author": "佚名",
      "grade": 1,
      "semester": "上",
      "genre": "五言绝句",
      "tags": ["咏物", "哲理"],
      "lines": ["远看山有色，", "近听水无声。", "春去花还在，", "人来鸟不惊。"],
      "notes": [
        { "w": "色", "t": "颜色。" },
        { "w": "无声", "t": "没有声音。" },
        { "w": "惊", "t": "受惊、害怕。" },
        { "w": "还", "t": "仍然。" }
      ],
      "translation": ["远远看去，山有青翠的颜色；走近去听，流水却没有声音。", "春天过去了，花儿还在盛开；人走近了，鸟儿也不惊飞。"]
    },
    {
      "id": 4,
      "title": "悯农（其二）",
      "dynasty": "唐",
      "author": "李绅",
      "grade": 1,
      "semester": "上",
      "genre": "五言绝句",
      "tags": ["劳动", "惜粮"],
      "lines": ["锄禾日当午，", "汗滴禾下土。", "谁知盘中餐，", "粒粒皆辛苦。"],
      "notes": [
        { "w": "锄禾", "t": "用锄头给禾苗松土、除草。" },
        { "w": "日当午", "t": "太阳正当中午。" },
        { "w": "餐", "t": "饭食。" },
        { "w": "皆", "t": "都。" }
      ],
      "translation": ["农民正午顶着烈日在田里锄草，汗水一滴滴落进禾苗下的泥土里。", "有谁知道碗里的饭食，每一粒都饱含着农民的辛苦。"]
    },
    {
      "id": 5,
      "title": "古朗月行（节选）",
      "dynasty": "唐",
      "author": "李白",
      "grade": 1,
      "semester": "上",
      "genre": "五言古诗",
      "tags": ["咏月", "想象"],
      "lines": ["小时不识月，", "呼作白玉盘。", "又疑瑶台镜，", "飞在青云端。"],
      "notes": [
        { "w": "呼作", "t": "称作、叫作。" },
        { "w": "白玉盘", "t": "白玉做成的盘子。" },
        { "w": "疑", "t": "怀疑。" },
        { "w": "瑶台", "t": "传说中神仙居住的地方。" }
      ],
      "translation": ["小时候不认识月亮，把它叫作白玉盘。", "又怀疑是瑶台上的仙镜，飞在青云之上。"]
    },
    {
      "id": 6,
      "title": "风",
      "dynasty": "唐",
      "author": "李峤",
      "grade": 1,
      "semester": "上",
      "genre": "五言绝句",
      "tags": ["咏物", "写景"],
      "lines": ["解落三秋叶，", "能开二月花。", "过江千尺浪，", "入竹万竿斜。"],
      "notes": [
        { "w": "解", "t": "能够。" },
        { "w": "三秋", "t": "深秋。" },
        { "w": "斜", "t": "倾斜。" },
        { "w": "过", "t": "经过、刮过。" }
      ],
      "translation": ["风能吹落深秋的树叶，能吹开二月的鲜花。", "它刮过江面能掀起千尺巨浪，吹进竹林能让万竿竹子倾斜。"]
    },
    {
      "id": 7,
      "title": "春晓",
      "dynasty": "唐",
      "author": "孟浩然",
      "grade": 1,
      "semester": "下",
      "genre": "五言绝句",
      "tags": ["写景", "春天"],
      "lines": ["春眠不觉晓，", "处处闻啼鸟。", "夜来风雨声，", "花落知多少。"],
      "notes": [
        { "w": "晓", "t": "天亮。" },
        { "w": "不觉晓", "t": "不知不觉天就亮了。" },
        { "w": "闻", "t": "听见。" },
        { "w": "啼鸟", "t": "鸟叫。" }
      ],
      "translation": ["春天睡得香甜，不知不觉天已经亮了，到处都能听见鸟儿的叫声。", "想起夜里传来的风雨声，不知道打落了多少花儿。"]
    },
    {
      "id": 8,
      "title": "赠汪伦",
      "dynasty": "唐",
      "author": "李白",
      "grade": 1,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["送别", "友情"],
      "lines": ["李白乘舟将欲行，", "忽闻岸上踏歌声。", "桃花潭水深千尺，", "不及汪伦送我情。"],
      "notes": [
        { "w": "将欲", "t": "将要。" },
        { "w": "踏歌", "t": "边走边唱，用脚踏地打拍子。" },
        { "w": "桃花潭", "t": "水潭名，在今安徽泾县。" },
        { "w": "不及", "t": "比不上。" }
      ],
      "translation": ["我乘船将要出发，忽然听见岸上传来踏歌的声音。", "桃花潭的水即使有千尺深，也比不上汪伦送别我的情谊深。"]
    },
    {
      "id": 9,
      "title": "静夜思",
      "dynasty": "唐",
      "author": "李白",
      "grade": 1,
      "semester": "下",
      "genre": "五言绝句",
      "tags": ["思乡", "咏月"],
      "lines": ["床前明月光，", "疑是地上霜。", "举头望明月，", "低头思故乡。"],
      "notes": [
        { "w": "疑", "t": "好像、以为。" },
        { "w": "举头", "t": "抬头。" },
        { "w": "思", "t": "思念。" },
        { "w": "故乡", "t": "家乡。" }
      ],
      "translation": ["床前洒满明亮的月光，好像地上铺了一层白霜。", "抬头望着天上的明月，低头思念远方的故乡。"]
    },
    {
      "id": 10,
      "title": "寻隐者不遇",
      "dynasty": "唐",
      "author": "贾岛",
      "grade": 1,
      "semester": "下",
      "genre": "五言绝句",
      "tags": ["访友", "写景"],
      "lines": ["松下问童子，", "言师采药去。", "只在此山中，", "云深不知处。"],
      "notes": [
        { "w": "隐者", "t": "隐居在山中的人。" },
        { "w": "童子", "t": "隐者的徒弟。" },
        { "w": "言", "t": "说。" },
        { "w": "不知处", "t": "不知道在什么地方。" }
      ],
      "translation": ["在松树下询问隐者的徒弟，他说师父采药去了。", "师父就在这座山里，只是云雾深深，不知道在什么地方。"]
    },
    {
      "id": 11,
      "title": "池上",
      "dynasty": "唐",
      "author": "白居易",
      "grade": 1,
      "semester": "下",
      "genre": "五言绝句",
      "tags": ["童趣", "写景"],
      "lines": ["小娃撑小艇，", "偷采白莲回。", "不解藏踪迹，", "浮萍一道开。"],
      "notes": [
        { "w": "小艇", "t": "小船。" },
        { "w": "偷", "t": "悄悄地。" },
        { "w": "不解", "t": "不懂得。" },
        { "w": "踪迹", "t": "行动留下的痕迹。" }
      ],
      "translation": ["一个小孩撑着小船，悄悄采了白莲回来。", "他不懂得隐藏自己的行踪，水面上的浮萍被船分开，留下一条水路。"]
    },
    {
      "id": 12,
      "title": "小池",
      "dynasty": "宋",
      "author": "杨万里",
      "grade": 1,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["写景", "夏天"],
      "lines": ["泉眼无声惜细流，", "树阴照水爱晴柔。", "小荷才露尖尖角，", "早有蜻蜓立上头。"],
      "notes": [
        { "w": "泉眼", "t": "泉水的出口。" },
        { "w": "惜", "t": "爱惜。" },
        { "w": "晴柔", "t": "晴天柔和的风光。" },
        { "w": "尖尖角", "t": "初生的荷叶尖端。" }
      ],
      "translation": ["泉眼悄无声息地流出细细的水流，好像爱惜它似的；树荫映在水面上，像是喜爱这晴天的柔美。", "小小的荷叶才露出尖尖的角，早有蜻蜓立在上面了。"]
    },
    {
      "id": 13,
      "title": "画鸡",
      "dynasty": "明",
      "author": "唐寅",
      "grade": 1,
      "semester": "下",
      "genre": "七言绝句",
      "tags": ["咏物", "动物"],
      "lines": ["头上红冠不用裁，", "满身雪白走将来。", "平生不敢轻言语，", "一叫千门万户开。"],
      "notes": [
        { "w": "裁", "t": "裁剪、制作。" },
        { "w": "走将来", "t": "走过来。" },
        { "w": "平生", "t": "平素、平时。" },
        { "w": "轻", "t": "轻易。" }
      ],
      "translation": ["头上的红冠不用裁剪就长成了，浑身雪白地走过来。", "它平时不轻易开口，一声啼叫，千家万户都打开门迎接天亮。"]
    }
  ]
}
